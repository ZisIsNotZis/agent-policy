#!/bin/sh
# The law's tool runs on the commit instead of on memory: it checks the corpus,
# regenerates the views, and stages what it generated, so a stale view cannot be
# committed. Enable once per clone:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
python3 tools/policy.py
git add -A agents/
