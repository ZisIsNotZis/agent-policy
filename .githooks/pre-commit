#!/bin/sh
# The law's tool runs on the commit instead of on memory, but only on a commit that
# changes the law: it checks the corpus, regenerates the views, and stages what it
# generated, so a stale view cannot be committed. A commit that only delivers a note
# into inbox/ is not blocked by another writer's half-finished law tree — a check that
# recomputes a tree it does not own reports that writer's state as this commit's defect.
# Enable once per clone:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only --diff-filter=ACDMR | grep -qE '^(AGENTS\.yaml|AGENTS\.schema\.yaml|roles\.yaml|banned\.yaml|tools/policy\.py|agents/)'; then
    python3 tools/policy.py
    git add -A agents/
fi
