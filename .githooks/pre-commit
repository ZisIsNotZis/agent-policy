#!/bin/sh
# The views are rendered from the law, never committed stale: a commit that touches
# the law, a banned term or the renderer regenerates them and stages what changed.
# Enable once per clone:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only --diff-filter=ACDMR | grep -qE '^(LAW\.md|banned\.txt|tools/render\.py|agents/|AGENTS\.md)'; then
    python3 tools/render.py
    git add -A agents/ AGENTS.md
fi
